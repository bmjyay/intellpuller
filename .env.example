# SQLite by default -- fine for a small internal-team deployment.
# Swap to a Postgres/MySQL connection string and change the provider in
# prisma/schema.prisma if you need multi-writer / hosted concurrency.
DATABASE_URL="file:./dev.db"

# Required for automated curation (summarizing findings, tagging domains,
# scoring quality, extracting metadata from raw URLs).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional: override the model used for curation. Defaults to a current
# Sonnet model, which is a good cost/quality balance for this workload.
ANTHROPIC_MODEL="claude-sonnet-5"

# Optional: shared secret required to hit /api/ingest from a scheduler
# (e.g. the GitHub Action in .github/workflows/ingest.yml). Leave blank to
# allow unauthenticated ingestion triggers (fine if the app itself is only
# reachable inside your internal network).
INGEST_TOKEN=""
